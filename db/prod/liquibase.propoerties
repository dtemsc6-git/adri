+# SQLcl Liquibase - produccion
# El esquema se toma de la conexion productiva; no se fija un nombre no documentado en el repositorio.
liquibase.command.defaultSchemaName=WKSP_DTESC_PROD
liquibase.command.filter=IN ('AUDIT_DETAIL','AUDIT_MASTER','SGT_ARCHIVOS','SGT_CIUDAD','SGT_COMENTARIOS','SGT_CONEXIONES_ENLACE_WAN','SGT_CONEXIONES_SERVICIO','SGT_DEPTO','SGT_ENLACES_FO','SGT_ENLACES_TRAMOS','SGT_ENLACES_WAN','SGT_ENLACES_WAN_SERVICIO','SGT_EQUIPOS','SGT_EQUIPOS_SERVICIO','SGT_EQUIPOS_WAN','SGT_INTERFACES','SGT_INTERFACES_L2','SGT_INTERFACES_L3','SGT_IP_ADM','SGT_RACKS','SGT_SALAS','SGT_SERVICIOS','SGT_SITIOS','SGT_SITIOS_ARCHIVOS','SGT_SITIOS_ENLACE_WAN','SGT_SITIOS_SERVICIO','SGT_TIPO_CABLE','SGT_TIPO_EQUIPOS','SGT_TIPO_INTERFAZ','SGT_TIPO_WAN','SGT_ZONAS','V_AUDIT_CONSOLIDADO','V_AUDIT_CUMPLIMIENTO','V_AUDIT_DASHBOARD_EJECUTIVO','V_AUDIT_DETALLE','V_AUDIT_EQUIPOS','V_AUDIT_GENERAL','V_CONEXIONES_GENERAL_V2','V_SERVICIOS','V_SITIOS_EQUIPOS','V_SITIOS_GPS','V_TRAMOS_NOMBRES','V_ZONAS_VISTA_GENERAL')
